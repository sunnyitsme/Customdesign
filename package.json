{
  "name": "guide-financial-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-pending.ts && node scripts/check-contrast.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-pending.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "test:e2e": "playwright test",
    "preview": "next dev -H 0.0.0.0 -p 3000",
    "preview:prod": "next build && next start -H 0.0.0.0 -p 3000",
    "build:pages": "node scripts/build-pages.mjs",
    "seo:doc": "node scripts/seo-doc.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
