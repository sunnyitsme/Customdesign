# Kept out of the Vercel upload. None of this is read at build or run time —
# verified: the only references to reference/ anywhere in the build path are in
# comments, and the two build scripts read app/globals.css and content/ only.
#
# public/ is deliberately NOT here: it is the served media (31MB, mostly the
# hero mp4) and Vercel needs it.

# Review screenshots — 39MB of PNGs regenerated by the Playwright suite.
shots/

# Project documentation and the captured review set (9MB).
docs/

# Source material for the migration, quoted in comments only.
reference/

# Tests and their config: Vercel does not run them.
tests/
playwright.config.ts
test-results/
playwright-report/

# The GitHub Pages preview pipeline. Vercel runs the normal Next build.
.github/
out/
